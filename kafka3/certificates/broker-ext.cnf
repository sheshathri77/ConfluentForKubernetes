[broker_cert]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth,clientAuth
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
subjectAltName = @alt_names

[alt_names]
DNS.1 = kafka-rbac
DNS.2 = kafka-rbac.confluent
DNS.3 = kafka-rbac.confluent.svc
DNS.4 = kafka-rbac.confluent.svc.cluster.local
DNS.5 = kafka-rbac-bootstrap
DNS.6 = kafka-rbac-bootstrap.confluent
DNS.7 = kafka-rbac-bootstrap.confluent.svc
DNS.8 = kafka-rbac-bootstrap.confluent.svc.cluster.local
DNS.9 = kafka-rbac.minikube.test
